# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local captures and diagnostics are not application sources.
/diag/
/test/failures/

# Kotlin Gradle caches
**/.kotlin/

# Vercel Build Output API directory produced by ci/vercel-web/prepare-output.js
/.vercel/
