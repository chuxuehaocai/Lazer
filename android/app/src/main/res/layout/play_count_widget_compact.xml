<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/play_count_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/play_count_widget_background">
    <ImageView
        android:id="@+id/recent_cover"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/recent_widget_cover_background"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />
    <ImageView
        android:id="@+id/recent_app_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/recent_widget_icon_background"
        android:clipToOutline="true"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">
        <TextView
            android:id="@+id/recent_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_recent_empty"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/recent_title_misans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"
            android:scaleType="fitStart"
            android:tint="@color/widget_primary"
            android:visibility="gone"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/recent_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/recent_artist_misans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="24dp"
            android:scaleType="fitStart"
            android:tint="@color/widget_secondary"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>
</RelativeLayout>
